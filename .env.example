# Copy this file to .env and fill in real values — .env is gitignored and never committed.
# This file (.env.example) IS committed, so anyone setting up the project
# knows which secrets they need, without ever seeing the actual values.

WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REDIRECT_URI=http://localhost:8080/oauth
WEBEX_ROOM_ID=

## Model API KEY; May want to use different model 
GEMINI_API_KEY=

## ADO Details
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
ADO_WORK_ITEM_TYPE=Bug
# Comma-separated board states that count as resolved (varies by process template)
ADO_RESOLVED_STATES=Done
